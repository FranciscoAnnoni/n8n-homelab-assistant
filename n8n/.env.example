# Copiar a .env (chmod 600). Nunca commitear el .env real.
N8N_VERSION=2.41.3
TZ=America/Argentina/Buenos_Aires

POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga
POSTGRES_DB=n8n

# Generar con: openssl rand -hex 32  (guardarla: sin ella no se pueden desencriptar las credenciales)
N8N_ENCRYPTION_KEY=

# IP o hostname de LAN donde se abre el editor
N8N_HOST=192.168.1.10

# URL pública para webhooks (Tailscale Funnel)
WEBHOOK_URL=https://<tu-maquina>.<tu-tailnet>.ts.net/
