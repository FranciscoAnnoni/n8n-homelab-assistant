          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=⚠️ Algo falló procesando el mensaje. Probá de nuevo en un rato.\n{{ String($json.error?.message ?? $json.error ?? \"\").slice(0, 300).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\") }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "reply_to_message_id": "={{ $('Telegram Trigger').item.json.message.message_id }}"
        }
      },
      "id": "7ce94ab3-3fb7-4402-92c1-e2de9813e1fe",
      "name": "Avisar error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1488,
        -272
      ],
      "webhookId": "ef893002-aeef-4a86-b595-d247fb5b0037",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURAR",
          "name": "Telegram account"
        }
      }
    }
  ],
