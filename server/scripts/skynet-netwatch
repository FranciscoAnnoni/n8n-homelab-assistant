#!/bin/bash
# skynet-netwatch — vigila la conectividad LAN y repara el WiFi escalonadamente.
#   3 fallos seguidos (~15 min) -> reinicia wpa_supplicant + networkd reconfigure
#   6 fallos seguidos (~30 min) -> recarga el driver rt2800usb
# Nunca reinicia el equipo. Todo queda en: journalctl -t skynet-netwatch
STATE=/run/skynet-netwatch; mkdir -p "$STATE"
FAILS_FILE="$STATE/fails"
log() { logger -t skynet-netwatch "$*"; }

IFACE=$(ls /sys/class/net | grep -m1 '^wl') || true
# Asegurar power-save OFF (por si un reconnect lo reactivó)
if [ -n "$IFACE" ] && iw dev "$IFACE" get power_save 2>/dev/null | grep -q ': on'; then
  iw dev "$IFACE" set power_save off && log "power_save estaba ON en $IFACE -> OFF"
fi

GW=$(ip -4 route show default | awk '{print $3; exit}')
fails=$(cat "$FAILS_FILE" 2>/dev/null || echo 0)

if [ -n "$GW" ] && ping -c 2 -W 3 "$GW" >/dev/null 2>&1; then
  [ "$fails" -gt 0 ] && log "RECUPERADO: gateway $GW responde otra vez (tras $fails fallos)"
  echo 0 > "$FAILS_FILE"; exit 0
fi

fails=$((fails + 1)); echo "$fails" > "$FAILS_FILE"
SIG=$( [ -n "$IFACE" ] && iw dev "$IFACE" link 2>/dev/null | awk '/signal/{print $2" dBm"}' )
log "FALLO $fails: sin respuesta del gateway '${GW:-sin ruta default}' (iface=${IFACE:-ninguna}, señal=${SIG:-desconectado})"

if [ "$fails" -eq 3 ] && [ -n "$IFACE" ]; then
  log "ACCIÓN: reinicio netplan-wpa-$IFACE + networkctl reconfigure"
  systemctl restart "netplan-wpa-$IFACE.service"; sleep 5; networkctl reconfigure "$IFACE"
elif [ "$fails" -eq 6 ]; then
  log "ACCIÓN: recargo driver rt2800usb"
  modprobe -r rt2800usb && sleep 3 && modprobe rt2800usb
  sleep 10; IFACE=$(ls /sys/class/net | grep -m1 '^wl') && networkctl reconfigure "$IFACE"
elif [ "$fails" -gt 6 ] && [ $((fails % 6)) -eq 0 ]; then
  log "SIGUE SIN RED hace ~$((fails*5)) min. Requiere revisión manual."
fi
